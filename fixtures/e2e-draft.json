{
  "siteId": "site_demo",
  "siteSalt": "demo-salt-0001",
  "settings": { "mode": "A", "allowedOrigins": ["http://localhost:4173"], "uuidCookieEnabled": true },
  "version": 999,
  "goals": [],
  "experiments": [
    {
      "id": "exp_injected",
      "name": "Draft only",
      "urlMatch": { "op": "contains", "value": "/preview" },
      "trafficPercentage": 100,
      "persistAssignment": false,
      "variants": [
        { "id": "vA", "name": "A", "weight": 50, "changes": [] },
        {
          "id": "vB",
          "name": "B",
          "weight": 50,
          "changes": [
            { "id": "c_draft", "type": "TEXT", "selector": ".preview-title", "payload": { "text": "下書きの見出し" } }
          ]
        }
      ]
    },
    {
      "id": "exp_injected_csp",
      "name": "Draft only (CSP page)",
      "urlMatch": { "op": "contains", "value": "/code-csp" },
      "trafficPercentage": 100,
      "persistAssignment": false,
      "variants": [
        { "id": "vA", "name": "A", "weight": 50, "changes": [] },
        {
          "id": "vB",
          "name": "B",
          "weight": 50,
          "changes": [
            { "id": "c_draft_css", "type": "CSS", "payload": { "css": ".code-title{letter-spacing:4px}" } },
            {
              "id": "c_draft_html",
              "type": "HTML",
              "selector": ".slot",
              "payload": { "html": "<script>window.__wttDraftScript=(window.__wttDraftScript||0)+1;</script>", "position": "append", "runScripts": true }
            },
            {
              "id": "c_draft_js",
              "type": "CUSTOM_JS",
              "selector": ".code-title",
              "payload": { "code": "element.setAttribute('data-draft-ctx', ctx.experimentId + '/' + ctx.variantId + '/' + ctx.changeId);" }
            }
          ]
        }
      ]
    }
  ]
}
