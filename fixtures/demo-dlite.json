{
  "siteId": "site_demo_dlite",
  "siteSalt": "demo-dlite-salt-0001",
  "version": 1,
  "goals": [{ "id": "g_dlite_buy", "name": "Buy click", "type": "CLICK", "config": { "selector": "#buy" } }],
  "settings": { "mode": "B", "hosts": ["localhost", "127.0.0.1"] },
  "experiments": [
    {
      "id": "exp_dlite", "name": "D-lite demo",
      "urlMatch": { "op": "contains", "value": "/" },
      "trafficPercentage": 100, "persistAssignment": true,
      "variants": [
        { "id": "vA", "name": "A", "weight": 50, "changes": [] },
        { "id": "vB", "name": "B", "weight": 50, "changes": [{ "id": "c_t", "type": "TEXT", "selector": ".hero-title", "payload": { "text": "D-lite B" } }] }
      ]
    },
    {
      "id": "exp_dlite_converted", "name": "D-lite converted",
      "urlMatch": { "op": "contains", "value": "/dlite.html" },
      "targeting": { "hist": "converted", "goal": "g_dlite_buy" },
      "trafficPercentage": 100, "persistAssignment": false,
      "variants": [
        { "id": "vA", "name": "A", "weight": 0, "changes": [] },
        { "id": "vB", "name": "B", "weight": 100, "changes": [{ "id": "c_c", "type": "TEXT", "selector": ".old-banner", "payload": { "text": "D-lite converted" } }] }
      ]
    }
  ]
}
