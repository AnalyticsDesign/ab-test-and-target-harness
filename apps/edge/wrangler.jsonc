{
  "name": "wtt-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // KV。`wrangler kv namespace create wtt-config` で作った id に置き換える。`--local` 実行時はこの id をキーにした
  // ローカルシミュレータが使われるため、e2e / edge:dev はこのままでも動く
  "kv_namespaces": [{ "binding": "CONFIG_KV", "id": "00000000000000000000000000000000" }],
  // IP あたり 20 req / 10 秒(wrangler >= 4.36。period は 10 か 60 のみ)
  "ratelimits": [{ "name": "DECISION_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 10 } }],
  // Visitor Profile。SQLite-backed(Free プランで利用可)。ID は idFromName("<siteId>:<visitorId>")
  // 結果の記録の 1 日の予算(ResultsBudget)は導入全体で 1 つ(idFromName("global"))。収集できなかった送信の数(ResultsHealth)はサイトごと(idFromName("<siteId>"))
  "durable_objects": {
    "bindings": [
      { "name": "VISITOR_PROFILE", "class_name": "VisitorProfile" },
      { "name": "RESULTS_BUDGET", "class_name": "ResultsBudget" },
      { "name": "RESULTS_HEALTH", "class_name": "ResultsHealth" }
    ]
  },
  // 計測用 D1(wtt-results。テストの結果の参加者ごとの記録)。`wrangler d1 create wtt-results` で作った database_id に置き換える(docs/deploy.md 2.2)。
  // マイグレーションは results-migrations/(`pnpm -C apps/edge results:migrate:local|remote`)
  "d1_databases": [
    { "binding": "RESULTS_DB", "database_name": "wtt-results", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "results-migrations" }
  ],
  // 結果の記録の 1 日の予算。守る順は「配信 > 管理操作 > 結果の記録」で、予算が尽きたら書かずに止める。値は正の整数の文字列で書く(省略・"0"・数でない値は既定 = 下の値になる。0 で記録を止めることはできない)
  "vars": {
    // 書き込みの 1 日(UTC)の上限の行数(インデックスの書き込みを含む)。Free の D1 は 1 日 10 万行なので、残りを配信・管理操作に残す
    "RESULTS_WRITE_BUDGET": "70000",
    // 読み取りの 1 日(UTC)の上限の行数。Free の D1 は 1 日 500 万行
    "RESULTS_READ_BUDGET": "3000000",
    // 予算の Durable Object が 1 回に配る枠の行数。大きいほど DO の呼び出しは減るが、isolate が消えたときに使われない枠が増える
    "RESULTS_LEASE_ROWS": "200"
  },
  // 初回デプロイで class を登録する。既存クラスの改名・削除をしない限り tag を増やさない
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VisitorProfile"] },
    // 結果の記録の予算と、収集できなかった送信の数(どちらも SQLite。Free プランで使える)
    { "tag": "v2", "new_sqlite_classes": ["ResultsBudget", "ResultsHealth"] }
  ],
  // 設置サイトのゾーンに紐づく Workers Route。`/v1/*` は decision / event。bootstrap(`/s/*`)は配信専用の Worker が受ける(docs/deploy.md を参照して自分のドメインに置き換える)。
  // Mode B(サーバー発行 Cookie)を使う Site は <site-domain>/__ab/* を、needsProfile の Site は <site-domain>/v1/* を同じ形式で追加する
  "routes": [
    { "pattern": "www.example.com/v1/*", "zone_name": "example.com" }
  ],
  // routes を書くと local mode の origin host が route になり、host で Site を引く Mode B の経路(/__ab/*)がローカルで 404 になる。
  // dev.host で localhost に固定して e2e の host 一致(demo-dlite の settings.hosts)を保つ
  "dev": { "host": "localhost" }
}
