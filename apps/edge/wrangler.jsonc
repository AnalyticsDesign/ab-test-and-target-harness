{
  "name": "wtt-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // KV。`wrangler kv namespace create wtt-config` で作った id に置き換える。`--local` 実行時はこの id をキーにした
  // ローカルシミュレータが使われるため、e2e / edge:dev はこのままでも動く
  "kv_namespaces": [{ "binding": "CONFIG_KV", "id": "00000000000000000000000000000000" }],
  // IP あたり 20 req / 10 秒(wrangler >= 4.36。period は 10 か 60 のみ)
  "ratelimits": [{ "name": "DECISION_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 10 } }],
  // Visitor Profile。SQLite-backed(Free プランで利用可)。ID は idFromName("<siteId>:<visitorId>")
  "durable_objects": { "bindings": [{ "name": "VISITOR_PROFILE", "class_name": "VisitorProfile" }] },
  // 初回デプロイで class を登録する。既存クラスの改名・削除をしない限り tag を増やさない
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VisitorProfile"] }],
  // 設置サイトのゾーンに紐づく Workers Route。`/v1/*` は decision / event。bootstrap(`/s/*`)は配信専用の Worker が受ける(docs/deploy.md を参照して自分のドメインに置き換える)。
  // Mode B(サーバー発行 Cookie)を使う Site は <site-domain>/__ab/* を、needsProfile の Site は <site-domain>/v1/* を同じ形式で追加する
  "routes": [
    { "pattern": "www.example.com/v1/*", "zone_name": "example.com" }
  ],
  // routes を書くと local mode の origin host が route になり、host で Site を引く Mode B の経路(/__ab/*)がローカルで 404 になる。
  // dev.host で localhost に固定して e2e の host 一致(demo-dlite の settings.hosts)を保つ
  "dev": { "host": "localhost" }
}
