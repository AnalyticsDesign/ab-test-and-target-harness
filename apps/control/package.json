{
  "name": "@wtt/control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "guide:build": "node scripts/embed-guide.mjs",
    "test": "node scripts/embed-guide.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev -c wrangler.jsonc -c ../admin/e2e/deployer.wrangler.jsonc",
    "auth:schema": "better-auth generate --config src/auth.cli.ts --output migrations/0001_better_auth.sql --yes",
    "d1:migrate:local": "wrangler d1 migrations apply wtt-control --local",
    "d1:migrate:remote": "wrangler d1 migrations apply wtt-control --remote"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.0",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@types/json-schema": "^7.0.15",
    "@wtt/core": "workspace:*",
    "@wtt/runtime": "workspace:*",
    "better-auth": "1.4.21",
    "hono": "^4.13.5",
    "hono-openapi": "^1",
    "kysely": "^0.29.5",
    "kysely-d1": "^0.4.0",
    "openapi-types": "^12.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@cloudflare/vitest-plugin": "^1.1.3",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
